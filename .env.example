# Copy this file to ".env" and edit MEDIA_PATH before starting.
# MEDIA_PATH = the folder on YOUR machine where uploaded images/videos/audio
# will actually be saved. Use an absolute path.
#
# Examples:
#   Windows (Docker Desktop):  MEDIA_PATH=C:/Users/YourName/ChatMedia
#   macOS/Linux:               MEDIA_PATH=/home/yourname/chat-media
MEDIA_PATH=./media
