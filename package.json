{
  "name": "keepsake-desktop",
  "version": "1.0.0",
  "description": "Keepsake — a private, self-hosted chat journal that runs entirely on your own laptop.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.keepsake.app",
    "productName": "Keepsake",
    "files": [
      "electron/**/*",
      "backend/server.js",
      "backend/public/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,.npmignore}"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1"
  }
}
